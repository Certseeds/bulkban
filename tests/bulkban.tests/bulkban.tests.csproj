  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\bulkban\bulkban.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="bulkban.tests.Support" />
  </ItemGroup>

</Project>
